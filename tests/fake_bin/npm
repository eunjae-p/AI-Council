#!/usr/bin/env python3
import sys, os
if os.environ.get("FAKE_LOG"):
    open(os.environ["FAKE_LOG"], "a").write("=====NPM " + repr(sys.argv[1:]) + "\n")
if os.environ.get("FAKE_NPM_FAIL"):
    sys.stderr.write("npm ERR! code EBUSY\nnpm ERR! resource busy or locked\n"); sys.exit(1)
print("changed 1 package in 3s")
