#!/usr/bin/env python3
import sys, re
import os
if os.environ.get("FAKE_NO_SEARCH") and "--search" in sys.argv: sys.stderr.write("error: unexpected argument '--search' found"); sys.exit(2)
if os.environ.get("FAKE_CONFIG_ERR") and "-c" in sys.argv: sys.stderr.write("Error loading config.toml: invalid transport"); sys.exit(1)
if sys.argv[1:3]==["mcp","list"]: print(os.environ.get("FAKE_CODEX_MCP","[]")); sys.exit(0)
if "--version" in sys.argv: print("codex-cli 0.154.0"); sys.exit(0)
if sys.argv[1:3]==["login","status"]: sys.exit(0)
p=sys.stdin.read()
import time
if "SLOWALL" in p or ("SLOWCLAUDE" in p and os.path.basename(sys.argv[0])=="claude"): time.sleep(30)
if "UNSUPPORTED" in p:
    sys.stderr.write("Reading prompt from stdin...\nuser\n"+p+"\nERROR: {\"message\":\"The 'gpt-6.1-sol' model is not supported when using Codex with a ChatGPT account.\"}\n"); sys.exit(1)
if "FAILGPT" in p: sys.stderr.write("fake codex error"); sys.exit(3)
if "EDIT_FILE" in p and "workspace-write" in sys.argv:
    open("gpt_new.txt","w").write("GPT가 만든 파일\n")
if "Image generation task" in p and "workspace-write" in sys.argv and not os.environ.get("FAKE_NO_IMAGE"):
    import base64, pathlib
    png = base64.b64decode("iVBORw0KGgoAAAANSUhEUgAAAAEAAAABCAYAAAAfFcSJAAAADUlEQVR42mP8z8BQDwAEhQGAhKmMIQAAAABJRU5ErkJggg==")
    d = pathlib.Path(os.environ.get("CODEX_HOME", os.path.expanduser("~/.codex"))) / "generated_images" / "sess1"
    d.mkdir(parents=True, exist_ok=True)
    n = 2 if "create 2 image" in p else 1
    for i in range(n): (d / ("ig_%d_%d.png" % (time.time_ns(), i))).write_bytes(png)
if os.environ.get("FAKE_LOG"):
    open(os.environ["FAKE_LOG"],"a").write("=====CODEX "+repr(sys.argv[1:])+"\n")
model = sys.argv[sys.argv.index("--model")+1] if "--model" in sys.argv else "gpt-6.1-sol"
sys.stderr.write("OpenAI Codex\n--------\nmodel: " + model + "\nprovider: openai\n")
print("GPT 답변: 받은 프롬프트 길이 %d" % len(p))
