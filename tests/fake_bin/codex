#!/usr/bin/env python3
import sys, re
import os
if os.environ.get("FAKE_NO_SEARCH") and "--search" in sys.argv: sys.stderr.write("error: unexpected argument '--search' found"); sys.exit(2)
if os.environ.get("FAKE_CONFIG_ERR") and "-c" in sys.argv: sys.stderr.write("Error loading config.toml: invalid transport"); sys.exit(1)
if sys.argv[1:3]==["mcp","list"]: print(os.environ.get("FAKE_CODEX_MCP","[]")); sys.exit(0)
if "--version" in sys.argv: print("codex-cli 0.154.0"); sys.exit(0)
if sys.argv[1:3]==["login","status"]: sys.exit(0)
p=sys.stdin.read()
import time
if "SLOWALL" in p or ("SLOWCLAUDE" in p and os.path.basename(sys.argv[0])=="claude"): time.sleep(30)
if "UNSUPPORTED" in p:
    sys.stderr.write("Reading prompt from stdin...\nuser\n"+p+"\nERROR: {\"message\":\"The 'gpt-6.1-sol' model is not supported when using Codex with a ChatGPT account.\"}\n"); sys.exit(1)
if "CAPACITY_ONCE" in p:
    mark = os.path.join(os.environ.get("T", "."), "capacity_mark")
    if not os.path.exists(mark):
        open(mark, "w").write("1"); sys.stderr.write("ERROR: Selected model is at capacity. Please try a different model."); sys.exit(1)
if "CAPACITY_ALWAYS" in p: sys.stderr.write("ERROR: Selected model is at capacity. Please try a different model."); sys.exit(1)
if "FAILGPT" in p: sys.stderr.write("fake codex error"); sys.exit(3)
if "EDIT_FILE" in p and "workspace-write" in sys.argv:
    open("gpt_new.txt","w").write("GPT가 만든 파일\n")
if ("Image generation task" in p or ("Images in this chat" in p and "IMG_REQ" in p.split("## Newest user question")[-1])) and "workspace-write" in sys.argv and not os.environ.get("FAKE_NO_IMAGE"):
    import base64, pathlib
    png = base64.b64decode("iVBORw0KGgoAAAANSUhEUgAAAAEAAAABCAYAAAAfFcSJAAAADUlEQVR42mP8z8BQDwAEhQGAhKmMIQAAAABJRU5ErkJggg==")
    d = pathlib.Path(os.environ.get("CODEX_HOME", os.path.expanduser("~/.codex"))) / "generated_images" / "sess1"
    d.mkdir(parents=True, exist_ok=True)
    n = 2 if ("create 2 image" in p or "Make 2 image" in p) else 1
    m = re.search(r"named (\S+)_1\.png", p)  # 진짜 GPT 처럼 작업 폴더에 prefix_N.png 로도 복사 (FAKE_NO_COPY 면 생략)
    for i in range(n):
        data = png + b"img%d" % i  # 장마다 내용이 다른 이미지
        (d / ("ig_%d_%d.png" % (time.time_ns(), i))).write_bytes(data)
        if m and not os.environ.get("FAKE_NO_COPY"):
            pathlib.Path("%s_%d.png" % (m.group(1), i + 1)).write_bytes(data)
if os.environ.get("FAKE_LOG"):
    open(os.environ["FAKE_LOG"],"a").write("=====CODEX "+repr(sys.argv[1:])+("\nMARK:CHAT_IMAGE_NOTE" if "Images in this chat" in p else "")
                                            +("\nMARK:CHAT_IMAGE_REFS" if "latest images in this chat" in p else "")
                                            +("\nMARK:FINAL_BLIND" if "Write the final conclusion card from the discussion" in p and "모델 A — replies on the disputed points" in p and "GPT — " not in p else "")
                                            +("\nMARK:RATIO=" + (re.search(r"Aspect ratio for new images: (\S+)", p).group(1) if re.search(r"Aspect ratio for new images: (\S+)", p) else "ASK" if "Aspect ratio: ask first" in p else "") if "Images in this chat" in p else "")+"\n")
model = sys.argv[sys.argv.index("--model")+1] if "--model" in sys.argv else "gpt-6.1-sol"
sys.stderr.write("OpenAI Codex\n--------\nmodel: " + model + "\nprovider: openai\n")
import fake_council
_fc = fake_council.answer(p)
print(_fc if _fc is not None else "GPT 답변: 받은 프롬프트 길이 %d" % len(p))
sys.stderr.write("tokens used\n12,345\n")
