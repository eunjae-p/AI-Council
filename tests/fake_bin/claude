#!/usr/bin/env python3
import sys,os,json
_JSON = "--output-format" in sys.argv and not os.environ.get("FAKE_PLAIN")
_DISCOVER = "stream-json" in sys.argv and "--tools" in sys.argv and sys.argv[sys.argv.index("--tools")+1] == "" and "--system-prompt" not in sys.argv
_STREAM = "stream-json" in sys.argv and not _DISCOVER
_DENY = []
def out(text):
    if _JSON:
        model = sys.argv[sys.argv.index("--model")+1] if "--model" in sys.argv else "claude-opus-5-5"
        res = {"type":"result","is_error":False,"result":text,"permission_denials":_DENY,
               "modelUsage":{"claude-haiku-4-5-20251001":{"outputTokens":30},model:{"outputTokens":12}}}
        if _STREAM:  # 진행 상황 줄 + 마지막 result 줄
            print(json.dumps({"type":"system","subtype":"init","mcp_servers":[{"name":"blender","status":"connected"}]}), flush=True)
            print(json.dumps({"type":"assistant","message":{"content":[{"type":"text","text":"작업을 시작합니다"},
                  {"type":"tool_use","name":"mcp__blender__execute_blender_code","input":{"code":"bpy.ops.mesh.primitive_cube_add()"}}]}}, ensure_ascii=False), flush=True)
        print(json.dumps(res, ensure_ascii=False))
    else:
        print(text)
if _DISCOVER:  # MCP 목록 확인: 시작 정보(init)만 내보내고 모델 답변 전 대기 (Council 이 종료시킴)
    print(json.dumps({"type":"system","subtype":"init","tools":["Read","mcp__claude_ai_Higgsfield__balance","mcp__claude_ai_Higgsfield__generate_video"],
          "mcp_servers":[{"name":"claude.ai Higgsfield","status":"connected"}]}), flush=True)
    import time; time.sleep(30); print(json.dumps({"type":"result","result":"late"})); sys.exit(0)
if "--version" in sys.argv: print("2.1.290 (Claude Code)"); sys.exit(0)
if sys.argv[1:3]==["mcp","list"]:
    print("Checking MCP server health...\n\nclaude.ai Higgsfield: https://mcp.higgsfield.ai/mcp - ✓ Connected\nblender: uv run --directory D:\\tools\\blender_mcp\\mcp blender-mcp - ✓ Connected\nbroken: x - ✗ Failed to connect"); sys.exit(0)
if sys.argv[1:3]==["auth","status"]: sys.exit(1)
if sys.argv[1:2]==["update"]: print("Successfully updated"); sys.exit(0)
p=sys.stdin.read()
import time
if "SLOWALL" in p or ("SLOWCLAUDE" in p and os.path.basename(sys.argv[0])=="claude"): time.sleep(30)
if os.environ.get("FAKE_OLD") and ("--system-prompt" in sys.argv or "--tools" in sys.argv):
    sys.stderr.write("error: unknown option '--system-prompt'"); sys.exit(1)
if "AUTH_EXPIRED" in p: print("Failed to authenticate: OAuth session expired and could not be refreshed"); sys.exit(1)
open(os.environ["FAKE_LOG"],"a").write("=====CLAUDE "+repr(sys.argv[1:])+" CWD="+os.getcwd()+"\n"+p+"\n")
if "long-term memory" in p:
    if os.environ.get("FAIL_SUMMARY"): sys.stderr.write("summary boom"); sys.exit(2)
    out("- 사용자 선호: 한국어\n- 결정: 요약 테스트"); sys.exit(0)
if "EDIT_FILE" in p and "acceptEdits" in sys.argv and "Implement the agreed conclusion" in p or ("EDIT_FILE" in p and "acceptEdits" in sys.argv and "planning round" not in p):
    open("claude_new.txt","w").write("Claude가 만든 파일\n")
    if os.path.exists("app.txt"): open("app.txt","a").write("Claude 수정\n")
    out("파일을 수정했습니다: claude_new.txt, app.txt"); sys.exit(0)
if "RUN_CMD:" in p and "Bash" in (sys.argv[sys.argv.index("--tools")+1] if "--tools" in sys.argv else ""):
    cmd = p.split("RUN_CMD:",1)[1].split("\n",1)[0].strip()
    allowed = sys.argv[sys.argv.index("--allowedTools")+1] if "--allowedTools" in sys.argv else ""
    import re as _re
    ok_ = any(cmd.startswith(m) for m in _re.findall(r"Bash\(([^:)]*):\*\)", allowed))
    if ok_: open("cmd_ran.txt","w").write(cmd); out("명령을 실행했습니다: "+cmd); sys.exit(0)
    _DENY.append({"tool_name":"Bash","tool_use_id":"b1","tool_input":{"command":cmd}}); out("명령 승인이 필요합니다"); sys.exit(0)
if "USE_MCP" in p:
    allowed = sys.argv[sys.argv.index("--allowedTools")+1] if "--allowedTools" in sys.argv else ""
    want = "mcp__claude_ai_Higgsfield__generate_video"
    if want in allowed: out("MCP 실행 결과: 생성 완료"); sys.exit(0)
    _DENY.append({"tool_name":want,"tool_use_id":"t1","tool_input":{"prompt":"고양이"}}); out("생성 도구 승인이 필요합니다"); sys.exit(0)
if "Create one final answer" in p or "moderator of a discussion" in p: out("Council 결론입니다 · 모델 A 의견이 더 타당"); sys.exit(0)
out("Claude 답변 ✓ 한글")
